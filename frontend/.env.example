# Frontend Environment Variables

# API Configuration
# URL del backend (por defecto usa localhost:5000)
# En producción cambiar a tu dominio real
VITE_API_URL=http://localhost:5000

# Stripe Public Configuration
# Obtén tu clave pública en: https://dashboard.stripe.com/apikeys
# IMPORTANTE: Usar SOLO la clave PÚBLICA (pk_test_* o pk_live_*), nunca la secreta
VITE_STRIPE_PUBLIC_KEY=pk_test_tu_clave_publica_de_stripe_aqui

# Environment
VITE_ENV=development