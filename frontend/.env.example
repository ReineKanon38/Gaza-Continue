# Frontend Environment Variables

# API Configuration
# URL del backend (por defecto usa localhost:5000)
# En producción cambiar a tu dominio real (Ej. https://api.syscomgaza.com)
VITE_API_URL=http://localhost:5000

# Stripe Public Key (Clave Publicable)
# Necesario para cargar el elemento de pago en el frontend
VITE_STRIPE_PUBLIC_KEY=pk_test_tu_clave_publica_stripe

# Environment
# En producción debe ser 'production'
VITE_ENV=development