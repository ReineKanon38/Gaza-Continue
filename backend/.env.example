# MongoDB Configuration
# URL de conexión a MongoDB (desarrollo local, cambiar en producción)
MONGODB_URI=mongodb://localhost:27017/sistema-gaza

# JWT Configuration
# Secret para firmar tokens (CÁMBIALO EN PRODUCCIÓN - usa un valor seguro y único)
JWT_SECRET=tu_secreto_jwt_super_seguro_cambiar_en_produccion
JWT_EXPIRES_IN=1d

# CORS Configuration
# URLs permitidas del frontend (separadas por comas)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# SYSCOM Integration (cuando esté listo)
# Obtén tus credenciales en: https://developers.syscom.mx
SYSCOM_API_URL=https://developers.syscom.mx/api/v1
SYSCOM_API_KEY=tu_api_key_syscom
SYSCOM_API_SECRET=tu_api_secret_syscom